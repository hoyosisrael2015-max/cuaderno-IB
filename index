async function renderPractice(){
  const u = STATE.user, s = STATE.session;
  const ctx = { cursoNombre: CURSO_NOMBRE, pruebaId:s.pruebaId, pruebaNombre:s.pruebaNombre, seccionId:s.seccionId, seccionNombre:s.seccionNombre, anio:s.anio, dificultad:s.dificultad };

  app.appendChild(el(`
    <div class="brand">
      <div class="brand-title"><h1>Cuaderno IB</h1><span class="stamp">Matemáticas</span></div>
      <div class="user-chip"><button class="btn ghost small" id="backBtn">← Volver al mapa</button></div>
    </div>
  `));
  app.querySelector('#backBtn').addEventListener('click', ()=>{ STATE.view='map'; render(); });

  const card = el(`<div class="practice-card"></div>`);
  app.appendChild(card);
  function diffDots(n){ return Array.from({length:5},(_,i)=>`<span class="${i<n?'on':''}"></span>`).join(''); }

  card.innerHTML = `
    <div class="practice-top">
      <div>
        <span class="code">${s.pruebaNombre} · ${s.seccionNombre}</span>
        <div style="margin-top:8px;font-size:15px;font-weight:600;">Año ${anioConSesion(s.anio)}</div>
      </div>
      <div><div class="meta" style="text-align:right;">Dificultad</div><div class="diff-dots">${diffDots(s.dificultad)}</div></div>
    </div>
    <div class="loading"><div class="spinner"></div>Obteniendo ejercicio…</div>
  `;

  let ejercicio;
  try{
    const progressNow = await getProgress(u.slug);
    const vistos = progressNow.buckets[s.bucketId]?.vistos || [];
    ejercicio = await pickOrGenerateEjercicio(ctx, s.bucketId, vistos);
  }catch(e){
    card.querySelector('.loading').outerHTML = `<div class="feedback bad">No se pudo obtener el ejercicio (${e.message}). Inténtalo de nuevo.</div>
      <div class="practice-actions"><button class="btn" id="retryBtn">Reintentar</button><div></div></div>`;
    card.querySelector('#retryBtn').addEventListener('click', renderPractice);
    return;
  }

  card.querySelector('.loading').remove();
  const tiempoInicio = Date.now();
  const marksPill = ejercicio.marcas ? `<div class="marks-pill" style="margin-top:6px;">${ejercicio.marcas} marks</div>` : '';
  const body = el(`
    <div>
      <div class="statement">${escapeHtml(ejercicio.enunciado)}</div>
      ${ejercicio.imagen ? `<img class="ex-image" src="${ejercicio.imagen}" alt="Diagrama del ejercicio">` : ''}
      ${marksPill}
      <div id="answerZone" style="margin-top:16px;"></div>
      <div class="practice-actions">
        <button class="btn" id="skipBtn">Saltar ejercicio</button>
        <button class="btn primary" id="submitBtn" disabled>Comprobar respuesta</button>
      </div>
      <div id="feedbackZone"></div>
    </div>
  `);
  card.appendChild(body);
  renderMath(card);

  let respuesta = '';
  const zone = card.querySelector('#answerZone');
  const submitBtn = card.querySelector('#submitBtn');

  if(ejercicio.tipo === 'opcion_multiple' && ejercicio.opciones && ejercicio.opciones.length){
    const opts = el(`<div class="options"></div>`);
    ejercicio.opciones.forEach(op=>{
      const o = el(`<div class="option">${op}</div>`);
      o.addEventListener('click', ()=>{
        [...opts.children].forEach(x=>x.classList.remove('picked'));
        o.classList.add('picked'); respuesta = op; submitBtn.disabled = false;
      });
      opts.appendChild(o);
    });
    zone.appendChild(opts);
  } else {
    const ta = el(`<textarea placeholder="Escribe tu respuesta aquí…"></textarea>`);
    ta.addEventListener('input', ()=>{ respuesta = ta.value.trim(); submitBtn.disabled = !respuesta; });
    zone.appendChild(ta);
  }

  card.querySelector('#skipBtn').addEventListener('click', ()=>{ STATE.view='map'; render(); });

  submitBtn.addEventListener('click', async ()=>{
    submitBtn.disabled = true;
    const fz = card.querySelector('#feedbackZone');
    fz.innerHTML = `<div class="loading"><div class="spinner"></div>Corrigiendo…</div>`;
    let resultado;
    try{
      resultado = await corregirRespuesta(ctx, ejercicio, respuesta);
    }catch(e){
      fz.innerHTML = `<div class="feedback bad">No se pudo corregir la respuesta. Inténtalo de nuevo.</div>`;
      submitBtn.disabled = false; return;
    }

    const duracionSeg = Math.round((Date.now() - tiempoInicio) / 1000);

    const progress = await getProgress(u.slug);
    const cur = progress.buckets[s.bucketId] || { mastery:0, attempts:0, correct:0, vistos:[], tiempoTotalSeg:0 };
    cur.attempts += 1;
    if(resultado.correcto){ cur.correct += 1; cur.mastery = Math.min(100, cur.mastery + 15 + s.dificultad*2); }
    else{ cur.mastery = Math.max(0, cur.mastery - 10); }
    cur.lastSeen = new Date().toISOString();
    cur.vistos = [...(cur.vistos||[]), ejercicio.id];
    cur.tiempoTotalSeg = (cur.tiempoTotalSeg || 0) + duracionSeg;
    progress.buckets[s.bucketId] = cur;

    progress.log = progress.log || [];
    progress.log.push({
      ts: new Date().toISOString(), bucketId: s.bucketId,
      pruebaNombre: s.pruebaNombre, seccionNombre: s.seccionNombre, anio: s.anio,
      correcto: resultado.correcto, duracionSeg, dificultad: s.dificultad
    });
    if(progress.log.length > 300) progress.log = progress.log.slice(-300); // limitar tamaño del historial

    await saveProgress(u.slug, progress);

    fz.innerHTML = `
      <div class="feedback ${resultado.correcto?'ok':'bad'}"><b>${resultado.correcto ? '✓ ¡Correcto!' : '✗ No del todo'}</b><br>${resultado.feedback}</div>
      <div style="font-size:11px;color:var(--ink-soft);margin-top:6px;">Tiempo en este ejercicio: ${duracionSeg < 60 ? duracionSeg+'s' : Math.floor(duracionSeg/60)+'min '+(duracionSeg%60)+'s'}</div>
      <button class="ms-toggle" id="peekToggle">Ver solucionario</button>
      <div class="mark-scheme" id="peekBox" style="display:none;">${ejercicio.solucionario ? escapeHtml(ejercicio.solucionario) : 'Respuesta: ' + escapeHtml(ejercicio.respuesta_correcta)}</div>
      <div class="practice-actions">
        <button class="btn" id="mapBtn">Volver al mapa</button>
        <button class="btn primary" id="nextBtn">Siguiente ejercicio</button>
      </div>
    `;
    fz.querySelector('#peekToggle').addEventListener('click', ()=>{
      const box = fz.querySelector('#peekBox');
      box.style.display = box.style.display==='none' ? 'block' : 'none';
    });
    fz.querySelector('#mapBtn').addEventListener('click', ()=>{ STATE.view='map'; render(); });
    fz.querySelector('#nextBtn').addEventListener('click', ()=>{
      STATE.session.dificultad = Math.max(1, Math.min(5, 1+Math.floor(cur.mastery/25)));
      render();
    });
    renderMath(fz);
  });
}

async function renderTeacher(){
  app.appendChild(el(`
    <div class="brand">
      <div class="brand-title"><h1>Cuaderno IB</h1><span class="stamp">Panel del profesor</span></div>
      <button class="btn ghost small" id="backBtn">← Volver</button>
    </div>
  `));
  app.querySelector('#backBtn').addEventListener('click', ()=>{ STATE.teacher=false; STATE.view='login'; render(); });

  const tabs = el(`
    <div class="tabs">
      <button data-t="alumnos" class="${STATE.teacherTab==='alumnos'?'on':''}">Alumnos</button>
      <button data-t="banco" class="${STATE.teacherTab==='banco'?'on':''}">Banco de ejercicios</button>
    </div>
  `);
  tabs.addEventListener('click', e=>{ const b=e.target.closest('button'); if(!b) return; STATE.teacherTab=b.dataset.t; render(); });
  app.appendChild(tabs);

  if(STATE.teacherTab === 'banco') return renderTeacherBank();

  app.appendChild(el(`<div class="loading"><div class="spinner"></div>Cargando lista de alumnos…</div>`));
  const roster = await getRoster();
  app.querySelector('.loading').remove();

  if(!roster.length){ app.appendChild(el(`<div class="empty">Todavía no hay alumnos registrados en este cuaderno.</div>`)); return; }

  const columnas = [];
  for(const pr of PRUEBAS) for(const sec of SECCIONES) columnas.push({label:`${pr.nombre} ${sec.nombre}`, prueba:pr.id, seccion:sec.id});

  const rows = await Promise.all(roster.map(async st=>{
    const progress = await getProgress(st.slug);
    const colAvgs = columnas.map(c=>{
      const ids = ANIOS.map(a=> examId(c.prueba, c.seccion, a));
      return Math.round(ids.reduce((s,id)=> s+(progress.buckets[id]?.mastery||0),0)/ids.length);
    });
    const overall = Math.round(colAvgs.reduce((a,b)=>a+b,0)/colAvgs.length);
    const tiempoTotalSeg = Object.values(progress.buckets||{}).reduce((s,b)=> s+(b.tiempoTotalSeg||0), 0);
    const lastSeenDates = Object.values(progress.buckets||{}).map(b=>b.lastSeen).filter(Boolean).sort();
    const ultimaActividad = lastSeenDates.length ? lastSeenDates[lastSeenDates.length-1] : null;
    return { ...st, colAvgs, overall, tiempoTotalSeg, ultimaActividad, log: progress.log || [] };
  }));
  rows.sort((a,b)=> b.overall - a.overall);

  function formatTiempo(seg){
    if(!seg) return '0 min';
    const h = Math.floor(seg/3600), m = Math.round((seg%3600)/60);
    return h > 0 ? `${h}h ${m}min` : `${m} min`;
  }
  function formatFecha(iso){
    if(!iso) return '—';
    const d = new Date(iso);
    return d.toLocaleDateString('es-ES', {day:'2-digit', month:'2-digit', year:'numeric'}) + ' ' + d.toLocaleTimeString('es-ES', {hour:'2-digit', minute:'2-digit'});
  }

  const table = el(`
    <table>
      <thead><tr><th>Alumno</th>${columnas.map(c=>`<th>${c.label}</th>`).join('')}<th>General</th><th>Tiempo total</th><th>Última actividad</th><th></th></tr></thead>
      <tbody></tbody>
    </table>
  `);
  const tbody = table.querySelector('tbody');
  tbody.innerHTML = rows.map(r => `
      <tr>
        <td class="name">${r.name}</td>
        ${r.colAvgs.map(v=>`<td><span class="mini-bar"><div style="width:${v}%;background:${masteryColor(v)}"></div></span>${v}%</td>`).join('')}
        <td><b>${r.overall}%</b></td>
        <td>${formatTiempo(r.tiempoTotalSeg)}</td>
        <td style="font-size:11.5px;">${formatFecha(r.ultimaActividad)}</td>
        <td><button class="btn ghost small detailBtn" data-slug="${r.slug}">Ver detalle</button></td>
      </tr>
  `).join('');
  app.appendChild(table);
  const detailZone = el(`<div id="detailZone"></div>`);
  app.appendChild(detailZone);

  table.querySelectorAll('.detailBtn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const r = rows.find(x=>x.slug===btn.dataset.slug);
      renderStudentDetail(r, detailZone, formatTiempo, formatFecha);
    });
  });

  app.appendChild(el(`<footer class="hint">Estos datos se generan a partir de la práctica de cada alumno en el cuaderno.</footer>`));
}

function renderStudentDetail(r, container, formatTiempo, formatFecha){
  const log = [...r.log].reverse().slice(0, 40); // más reciente primero
  const total = r.log.length;
  const correctas = r.log.filter(e=>e.correcto).length;
  const aciertoGlobal = total ? Math.round(correctas/total*100) : 0;
  const tiempoProm = total ? Math.round(r.log.reduce((s,e)=>s+e.duracionSeg,0)/total) : 0;
  const ultimos10 = r.log.slice(-10);
  const aciertoReciente = ultimos10.length ? Math.round(ultimos10.filter(e=>e.correcto).length/ultimos10.length*100) : null;
  const tendencia = (aciertoReciente!==null && total>=10)
    ? (aciertoReciente > aciertoGlobal ? `↑ mejorando (${aciertoReciente}% en los últimos 10)`
      : aciertoReciente < aciertoGlobal ? `↓ bajando (${aciertoReciente}% en los últimos 10)`
      : `estable (${aciertoReciente}% en los últimos 10)`)
    : 'aún sin suficientes datos';

  container.innerHTML = '';
  const panel = el(`
    <div class="bank-panel" style="margin-top:16px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
        <b>Avance de ${r.name}</b>
        <span style="font-size:11.5px;color:var(--ink-soft);">Última actividad: ${formatFecha(r.ultimaActividad)}</span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:18px;">
        <div class="ex-item" style="margin:0;text-align:center;">
          <div style="font-family:'JetBrains Mono',monospace;font-weight:700;font-size:18px;">${total}</div>
          <div style="font-size:10.5px;color:var(--ink-soft);">Intentos totales</div>
        </div>
        <div class="ex-item" style="margin:0;text-align:center;">
          <div style="font-family:'JetBrains Mono',monospace;font-weight:700;font-size:18px;color:${masteryColor(aciertoGlobal)};">${aciertoGlobal}%</div>
          <div style="font-size:10.5px;color:var(--ink-soft);">Aciertos (global)</div>
        </div>
        <div class="ex-item" style="margin:0;text-align:center;">
          <div style="font-family:'JetBrains Mono',monospace;font-weight:700;font-size:18px;">${formatTiempo(r.tiempoTotalSeg)}</div>
          <div style="font-size:10.5px;color:var(--ink-soft);">Tiempo acumulado</div>
        </div>
        <div class="ex-item" style="margin:0;text-align:center;">
          <div style="font-family:'JetBrains Mono',monospace;font-weight:700;font-size:13px;">${tendencia}</div>
          <div style="font-size:10.5px;color:var(--ink-soft);">Tendencia reciente</div>
        </div>
      </div>
      ${log.length ? `
      <table>
        <thead><tr><th>Fecha</th><th>Prueba</th><th>Resultado</th><th>Tiempo</th><th>Dificultad</th></tr></thead>
        <tbody>
          ${log.map(e=>`
            <tr>
              <td style="font-size:11.5px;">${formatFecha(e.ts)}</td>
              <td style="font-size:11.5px;">${e.pruebaNombre} · ${e.seccionNombre} · ${e.anio}</td>
              <td>${e.correcto ? '<span style="color:var(--m-high);">✓ Correcto</span>' : '<span style="color:var(--m-low);">✗ Incorrecto</span>'}</td>
              <td style="font-size:11.5px;">${e.duracionSeg < 60 ? e.duracionSeg+'s' : Math.floor(e.duracionSeg/60)+'min '+(e.duracionSeg%60)+'s'}</td>
              <td style="font-size:11.5px;">${e.dificultad}/5</td>
            </tr>
          `).join('')}
        </tbody>
      </table>
      ${r.log.length > 40 ? `<div style="font-size:11px;color:var(--ink-soft);margin-top:8px;">Mostrando los 40 intentos más recientes.</div>` : ''}
      ` : `<div class="empty">Este alumno todavía no tiene intentos registrados.</div>`}
    </div>
  `);
  container.appendChild(panel);
  panel.scrollIntoView({behavior:'smooth', block:'nearest'});
}

async function renderTeacherBank(){
  if(!STATE.bankPrueba) STATE.bankPrueba = 'P1';
  const layout = el(`<div class="bank-layout"></div>`);
  app.appendChild(layout);
  const nav = el(`<div class="bank-nav"></div>`);
  layout.appendChild(nav);
  const panel = el(`<div class="bank-panel"><div class="loading"><div class="spinner"></div>Cargando banco…</div></div>`);
  layout.appendChild(panel);

  for(const pr of PRUEBAS){
    nav.appendChild(el(`<div class="tema-name">${pr.nombre}</div>`));
    for(const sec of SECCIONES){
      for(const anio of ANIOS){
        const bucketId = examId(pr.id, sec.id, anio);
        const bank = await getBank(bucketId);
        const on = STATE.bankPrueba===pr.id && STATE.bankSeccion===sec.id && STATE.bankAnio===anio;
        const btn = el(`<button class="sub-btn ${on?'on':''}"><span>${sec.nombre} · ${anioConSesion(anio)}</span><span class="n">${bank.length}</span></button>`);
        btn.addEventListener('click', ()=>{ STATE.bankPrueba=pr.id; STATE.bankSeccion=sec.id; STATE.bankAnio=anio; render(); });
        nav.appendChild(btn);
      }
    }
  }

  if(!STATE.bankSeccion || STATE.bankAnio==null){
    panel.innerHTML = `<div class="empty">Elige Prueba, Sección y Año a la izquierda para ver y editar sus ejercicios.</div>`;
    return;
  }

  const bucketId = examId(STATE.bankPrueba, STATE.bankSeccion, STATE.bankAnio);
  const pruebaNombre = PRUEBAS.find(p=>p.id===STATE.bankPrueba).nombre;
  const seccionNombre = SECCIONES.find(s=>s.id===STATE.bankSeccion).nombre;
  const bank = await getBank(bucketId);
  panel.innerHTML = '';
  panel.appendChild(el(`
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
      <div>
        <b>${pruebaNombre} · ${seccionNombre} · ${anioConSesion(STATE.bankAnio)}</b>
        <div style="font-size:11.5px;color:var(--ink-soft);margin-top:2px;">${bank.length} ejercicio(s)</div>
      </div>
      <button class="btn primary small" id="addExBtn">+ Añadir ejercicio</button>
    </div>
  `));
  const listEl = el(`<div id="exList"></div>`);
  panel.appendChild(listEl);

  function renderList(){
    listEl.innerHTML = '';
    if(!bank.length){ listEl.appendChild(el(`<div class="empty">Todavía no hay ejercicios aquí. Se generarán automáticamente cuando un alumno practique este año, o puedes añadir uno tú.</div>`)); return; }
    bank.slice().reverse().forEach(ex=>{
      const item = el(`
        <div class="ex-item">
          <div class="ex-top">
            <span class="badge ${ex.origen==='profesor'?'prof':'ia'}">${ex.origen==='profesor'?'PROFESOR':'IA'}</span>
            <span class="meta" style="font-size:11px;color:var(--ink-soft);">Dificultad ${ex.dificultad}/5 ${ex.marcas?`· ${ex.marcas} marks`:''}</span>
          </div>
          <div class="ex-text">${escapeHtml(ex.enunciado)}</div>
          ${ex.imagen ? `<img class="ex-image-thumb" src="${ex.imagen}" alt="Diagrama del ejercicio">` : ''}
          <div class="ex-meta">Respuesta: <b>${escapeHtml(ex.respuesta_correcta)}</b>${ex.tipo==='opcion_multiple' ? ' · Opción múltiple ('+ex.opciones.length+' opciones)' : ' · Respuesta corta'}</div>
          ${ex.fuente ? `<div class="ex-meta" style="font-style:italic;">${ex.fuente}</div>` : ''}
          ${ex.solucionario ? `<div class="mark-scheme" style="margin-top:10px;">${escapeHtml(ex.solucionario)}</div>` : ''}
          <div class="ex-actions"><button class="editBtn">Editar</button><button class="delBtn">Eliminar</button></div>
        </div>
      `);
      item.querySelector('.editBtn').addEventListener('click', ()=> openForm(ex));
      item.querySelector('.delBtn').addEventListener('click', async ()=>{
        if(!confirm('¿Eliminar este ejercicio del banco?')) return;
        await deleteExerciseFromBank(bucketId, ex.id);
        render();
      });
      listEl.appendChild(item);
    });
  }
  renderList();
  renderMath(listEl);

  function openForm(existing){
    const isEdit = !!existing;
    let imagenActual = isEdit ? (existing.imagen || null) : null;
    const formWrap = el(`
      <div class="bank-panel" style="margin-top:14px;border:1.5px dashed var(--paper-line);box-shadow:none;">
        <h3 style="font-size:15px;margin-bottom:14px;">${isEdit?'Editar ejercicio':'Nuevo ejercicio'}</h3>
        <div class="field"><label>Enunciado</label><textarea id="fEnunciado" rows="3">${isEdit?existing.enunciado:''}</textarea>
          <div style="font-size:11px;color:var(--ink-soft);margin-top:4px;">Para ecuaciones, escríbelas en LaTeX entre signos de dólar — ej. <code>$x^2$</code>, <code>$\sqrt{x}$</code> — y se verán como una ecuación real (igual que en Word). Si escribiste la ecuación en Word con su editor, pásamela y yo la convierto a este formato por ti.</div>
          <div style="font-size:11px;color:var(--ink-soft);margin-top:6px;font-weight:600;">Vista previa (así lo verá el alumno):</div>
          <div id="fEnunciadoPreview" class="preview-box"></div>
        </div>
        <div class="field">
          <label>Imagen / diagrama (opcional — ej. un triángulo, una gráfica)</label>
          <div class="img-upload-row">
            <input type="file" id="fImagen" accept="image/*">
            <span id="imgStatus" style="font-size:11.5px;color:var(--ink-soft);">${imagenActual ? 'Imagen cargada' : 'Sin imagen'}</span>
          </div>
          <div id="imgPreviewWrap">${imagenActual ? `<img class="ex-image-thumb" id="imgPreview" src="${imagenActual}"><button class="img-remove-btn" id="imgRemoveBtn">Quitar imagen</button>` : ''}</div>
        </div>
        <div class="form-row">
          <div class="field"><label>Tipo</label>
            <select id="fTipo">
              <option value="corta" ${isEdit&&existing.tipo==='corta'?'selected':''}>Respuesta corta</option>
              <option value="opcion_multiple" ${isEdit&&existing.tipo==='opcion_multiple'?'selected':''}>Opción múltiple</option>
            </select>
          </div>
          <div class="field"><label>Dificultad</label>
            <select id="fDificultad">${[1,2,3,4,5].map(n=>`<option value="${n}" ${isEdit&&existing.dificultad===n?'selected':''}>${n}</option>`).join('')}</select>
          </div>
        </div>
        <div class="field" id="opcionesField" style="display:${isEdit&&existing.tipo==='opcion_multiple'?'block':'none'}">
          <label>Opciones (una por línea)</label>
          <textarea id="fOpciones" rows="4">${isEdit&&existing.opciones?existing.opciones.join('\n'):''}</textarea>
        </div>
        <div class="field"><label>Respuesta correcta</label><input type="text" id="fRespuesta" value="${isEdit?existing.respuesta_correcta:''}"></div>
        <div class="form-row"><div class="field"><label>Marcas totales</label><input type="text" id="fMarcas" value="${isEdit&&existing.marcas?existing.marcas:''}" placeholder="ej. 5"></div></div>
        <div class="field"><label>Solucionario (mark scheme, notación M1/A1/R1)</label><textarea id="fSolucionario" rows="5">${isEdit?(existing.solucionario||''):''}</textarea>
          <div style="font-size:11px;color:var(--ink-soft);margin-top:6px;font-weight:600;">Vista previa:</div>
          <div id="fSolucionarioPreview" class="preview-box"></div>
        </div>
        <div style="display:flex;gap:10px;">
          <button class="btn primary" id="saveExBtn">${isEdit?'Guardar cambios':'Añadir al banco'}</button>
          <button class="btn ghost" id="cancelExBtn">Cancelar</button>
        </div>
      </div>
    `);
    panel.appendChild(formWrap);
    formWrap.scrollIntoView({behavior:'smooth', block:'nearest'});
    formWrap.querySelector('#fTipo').addEventListener('change', e=>{
      formWrap.querySelector('#opcionesField').style.display = e.target.value==='opcion_multiple' ? 'block':'none';
    });

    function wirePreview(textareaId, previewId){
      const ta = formWrap.querySelector('#'+textareaId);
      const preview = formWrap.querySelector('#'+previewId);
      function update(){
        preview.innerHTML = escapeHtml(ta.value);
        renderMath(preview);
      }
      ta.addEventListener('input', update);
      update();
    }
    wirePreview('fEnunciado', 'fEnunciadoPreview');
    wirePreview('fSolucionario', 'fSolucionarioPreview');

    function resizeImage(file, maxWidth=900, quality=0.82){
      return new Promise((resolve, reject)=>{
        const reader = new FileReader();
        reader.onload = ()=>{
          const img = new Image();
          img.onload = ()=>{
            const scale = Math.min(1, maxWidth / img.width);
            const canvas = document.createElement('canvas');
            canvas.width = Math.round(img.width * scale);
            canvas.height = Math.round(img.height * scale);
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#fff';
            ctx.fillRect(0,0,canvas.width,canvas.height);
            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
            resolve(canvas.toDataURL('image/jpeg', quality));
          };
          img.onerror = reject;
          img.src = reader.result;
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    formWrap.querySelector('#fImagen').addEventListener('change', async (e)=>{
      const file = e.target.files[0];
      if(!file) return;
      formWrap.querySelector('#imgStatus').textContent = 'Procesando imagen…';
      try{
        imagenActual = await resizeImage(file);
        formWrap.querySelector('#imgPreviewWrap').innerHTML = `<img class="ex-image-thumb" id="imgPreview" src="${imagenActual}"><button class="img-remove-btn" id="imgRemoveBtn">Quitar imagen</button>`;
        formWrap.querySelector('#imgStatus').textContent = 'Imagen cargada';
        formWrap.querySelector('#imgRemoveBtn').addEventListener('click', ()=>{
          imagenActual = null;
          formWrap.querySelector('#imgPreviewWrap').innerHTML = '';
          formWrap.querySelector('#imgStatus').textContent = 'Sin imagen';
          formWrap.querySelector('#fImagen').value = '';
        });
      }catch(err){
        formWrap.querySelector('#imgStatus').textContent = 'No se pudo procesar la imagen';
      }
    });
    if(formWrap.querySelector('#imgRemoveBtn')){
      formWrap.querySelector('#imgRemoveBtn').addEventListener('click', ()=>{
        imagenActual = null;
        formWrap.querySelector('#imgPreviewWrap').innerHTML = '';
        formWrap.querySelector('#imgStatus').textContent = 'Sin imagen';
        formWrap.querySelector('#fImagen').value = '';
      });
    }

    formWrap.querySelector('#cancelExBtn').addEventListener('click', ()=> formWrap.remove());
    formWrap.querySelector('#saveExBtn').addEventListener('click', async ()=>{
      const enunciado = formWrap.querySelector('#fEnunciado').value.trim();
      const tipo = formWrap.querySelector('#fTipo').value;
      const dificultad = parseInt(formWrap.querySelector('#fDificultad').value,10);
      const respuesta_correcta = formWrap.querySelector('#fRespuesta').value.trim();
      const marcas = parseInt(formWrap.querySelector('#fMarcas').value,10) || null;
      const solucionario = formWrap.querySelector('#fSolucionario').value.trim();
      const opciones = tipo==='opcion_multiple' ? formWrap.querySelector('#fOpciones').value.split('\n').map(s=>s.trim()).filter(Boolean) : [];
      if(!enunciado || !respuesta_correcta || (tipo==='opcion_multiple' && opciones.length<2)){
        alert('Completa el enunciado, la respuesta correcta y, si es opción múltiple, al menos 2 opciones.');
        return;
      }
      try{
        if(isEdit){
          await updateExerciseInBank(bucketId, existing.id, { enunciado, tipo, dificultad, respuesta_correcta, opciones, marcas, solucionario, imagen: imagenActual });
        } else {
          await addExerciseToBank(bucketId, { id:newExerciseId(), enunciado, tipo, dificultad, respuesta_correcta, opciones, marcas, solucionario, imagen: imagenActual, origen:'profesor', creado:new Date().toISOString() });
        }
        render();
      }catch(e){ alert('No se pudo guardar: '+e.message); }
    });
  }

  panel.querySelector('#addExBtn').addEventListener('click', ()=> openForm(null));
}

seedBankIfEmpty().then(render);
</script>
