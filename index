async function seedBankIfEmpty(){
  const byBucket = {};
  for(const seed of SEED_EXERCISES){
    const id = examId(seed.prueba, seed.seccion, seed.anio);
    (byBucket[id] = byBucket[id] || []).push(seed);
  }
  for(const bucketId in byBucket){
    const bank = await getBank(bucketId);
    for(const seed of byBucket[bucketId]){
      if(!bank.find(e=>e.id===seed.id)){
        await addExerciseToBank(bucketId, {
          id: seed.id, enunciado: seed.enunciado, tipo: seed.tipo || 'corta', opciones: seed.opciones || [],
          respuesta_correcta: seed.respuesta_correcta, solucionario: seed.solucionario,
          marcas: seed.marcas, dificultad: seed.dificultad, origen:'profesor', fuente: seed.fuente || null,
          imagen: seed.imagen || null,
          creado: new Date().toISOString()
        });
        bank.push({id:seed.id});
      }
    }
  }
}

