<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cuaderno IB · Matemáticas</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/contrib/auto-render.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1B2A4A;
    --ink-soft:#4A5772;
    --paper:#EEF2F7;
    --paper-line:#D9E1EC;
    --card:#FFFFFF;
    --aa:#2F7A5C;
    --aa-soft:#E4F1EB;
    --ai:#C77D3F;
    --ai-soft:#F7E9DA;
    --m-none:#C9CFD9;
    --m-low:#CC5B4E;
    --m-mid:#DFA23A;
    --m-high:#2F7A5C;
    --radius:10px;
    --shadow: 0 1px 2px rgba(27,42,74,0.06), 0 4px 14px rgba(27,42,74,0.06);
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    font-family:'Inter',sans-serif;
    color:var(--ink);
    background:
      linear-gradient(var(--paper-line) 1px, transparent 1px) 0 0/100% 28px,
      linear-gradient(90deg, var(--paper-line) 1px, transparent 1px) 0 0/28px 100%,
      var(--paper);
    background-attachment:local;
    min-height:100vh;
    font-size:15px;
  }
  .wrap{max-width:980px;margin:0 auto;padding:28px 20px 60px;}
  h1,h2,h3{font-family:'Fraunces',serif;font-weight:600;margin:0;color:var(--ink);}
  .brand{display:flex;align-items:center;justify-content:space-between;margin-bottom:26px;}
  .brand-title{display:flex;align-items:baseline;gap:10px;}
  .brand-title h1{font-size:26px;letter-spacing:-0.01em;}
  .brand-title .stamp{
    font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.06em;
    background:var(--ink);color:#fff;padding:2px 7px;border-radius:4px;
  }
  .user-chip{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--ink-soft);}
  .user-chip b{color:var(--ink);}
  .btn{
    font-family:'Inter',sans-serif;font-weight:600;font-size:13.5px;
    border:1.5px solid var(--ink);background:#fff;color:var(--ink);
    padding:9px 16px;border-radius:7px;cursor:pointer;transition:transform .08s ease, background .15s ease;
  }
  .btn:hover{background:var(--ink);color:#fff;}
  .btn:active{transform:scale(0.97);}
  .btn.ghost{border-color:transparent;background:transparent;color:var(--ink-soft);padding:6px 8px;}
  .btn.ghost:hover{background:var(--paper-line);color:var(--ink);}
  .btn.primary{background:var(--ink);color:#fff;}
  .btn.primary:hover{background:#0f1b33;}
  .btn.small{padding:6px 11px;font-size:12.5px;border-radius:6px;}
  .btn:disabled{opacity:.45;cursor:default;}
  .btn:disabled:hover{background:#fff;color:var(--ink);}

  /* Login */
  .login-card{
    max-width:460px;margin:60px auto;background:var(--card);border-radius:var(--radius);
    box-shadow:var(--shadow);padding:32px 30px;border-top:4px solid var(--ink);
  }
  .login-card h2{font-size:22px;margin-bottom:4px;}
  .login-card p.sub{color:var(--ink-soft);font-size:13.5px;margin:0 0 22px;}
  label{display:block;font-size:12.5px;font-weight:600;color:var(--ink-soft);margin:16px 0 6px;text-transform:uppercase;letter-spacing:.04em;}
  input[type=text]{
    width:100%;padding:10px 12px;border:1.5px solid var(--paper-line);border-radius:7px;
    font-family:'Inter',sans-serif;font-size:15px;background:#fdfdfd;
  }
  input[type=text]:focus{outline:none;border-color:var(--ink);}
  .seg{display:flex;gap:8px;}
  .seg button{
    flex:1;padding:10px;border-radius:7px;border:1.5px solid var(--paper-line);background:#fff;
    font-family:'Inter',sans-serif;font-weight:600;font-size:13.5px;cursor:pointer;color:var(--ink-soft);
  }
  .seg button.on{border-color:var(--ink);color:var(--ink);background:var(--paper);}
  .login-actions{margin-top:24px;display:flex;gap:10px;align-items:center;}
  .teacher-link{margin-top:18px;text-align:center;}
  .teacher-link a{color:var(--ink-soft);font-size:12.5px;cursor:pointer;text-decoration:underline;}
  .note{font-size:11.5px;color:var(--ink-soft);margin-top:20px;line-height:1.5;border-top:1px dashed var(--paper-line);padding-top:14px;}

  /* Course header on map */
  .course-banner{
    display:flex;align-items:center;justify-content:space-between;background:var(--card);
    border-radius:var(--radius);padding:18px 22px;box-shadow:var(--shadow);margin-bottom:22px;
  }
  .course-banner .tag{
    display:inline-block;font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:700;
    padding:3px 9px;border-radius:5px;letter-spacing:.03em;
  }
  .tag.AA{background:var(--aa-soft);color:var(--aa);}
  .tag.AI{background:var(--ai-soft);color:var(--ai);}
  .overall-ring{display:flex;align-items:center;gap:12px;}
  .ring{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;
    font-family:'JetBrains Mono',monospace;font-weight:700;font-size:13px;color:#fff;}

  /* Topic cards (index-card signature) */
  .tema{
    background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);margin-bottom:16px;
    overflow:hidden;position:relative;
  }
  .tema::before{
    content:'';position:absolute;top:14px;left:14px;width:8px;height:8px;border-radius:50%;
    background:var(--paper);box-shadow:inset 0 1px 2px rgba(0,0,0,.15);
  }
  .tema-head{display:flex;align-items:center;justify-content:space-between;padding:16px 20px 16px 34px;cursor:pointer;}
  .tema-head .left{display:flex;align-items:center;gap:12px;}
  .tema-head h3{font-size:17px;}
  .tema-head .count{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-soft);}
  .tema-bar{width:120px;height:7px;background:var(--paper);border-radius:4px;overflow:hidden;}
  .tema-bar>div{height:100%;background:var(--m-high);}
  .chevron{transition:transform .2s ease;color:var(--ink-soft);}
  .tema.open .chevron{transform:rotate(90deg);}
  .sub-list{max-height:0;overflow:hidden;transition:max-height .25s ease;}
  .tema.open .sub-list{max-height:2000px;}
  .sub-item{
    display:flex;align-items:center;justify-content:space-between;padding:11px 20px 11px 34px;
    border-top:1px solid var(--paper-line);cursor:pointer;
  }
  .sub-item:hover{background:var(--paper);}
  .sub-item .info{display:flex;align-items:center;gap:10px;}
  .code{font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--ink-soft);
    background:var(--paper);padding:2px 6px;border-radius:4px;min-width:58px;text-align:center;}
  .code.ns{background:#EDE3F5;color:#6B4A94;}
  .dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}
  .cells{display:flex;gap:2px;}
  .cell{width:7px;height:7px;border-radius:1.5px;background:var(--m-none);}

  /* Practice */
  .practice-card{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:28px;}
  .practice-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:18px;}
  .practice-top .meta{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-soft);}
  .diff-dots{display:flex;gap:4px;margin-top:6px;}
  .diff-dots span{width:8px;height:8px;border-radius:50%;background:var(--paper-line);}
  .diff-dots span.on{background:var(--ink);}
  .statement{font-size:17px;line-height:1.65;margin:6px 0 22px;white-space:pre-wrap;}
  .options{display:flex;flex-direction:column;gap:8px;margin-bottom:18px;}
  .option{
    padding:11px 14px;border:1.5px solid var(--paper-line);border-radius:8px;cursor:pointer;font-size:14.5px;
  }
  .option:hover{border-color:var(--ink);}
  .option.picked{border-color:var(--ink);background:var(--paper);font-weight:600;}
  textarea{
    width:100%;min-height:70px;padding:12px;border:1.5px solid var(--paper-line);border-radius:8px;
    font-family:'Inter',sans-serif;font-size:14.5px;resize:vertical;
  }
  textarea:focus{outline:none;border-color:var(--ink);}
  .feedback{margin-top:18px;padding:16px 18px;border-radius:8px;font-size:14px;line-height:1.55;}
  .feedback.ok{background:var(--aa-soft);border-left:4px solid var(--aa);}
  .feedback.bad{background:#FBEAE7;border-left:4px solid var(--m-low);}
  .practice-actions{margin-top:20px;display:flex;gap:10px;justify-content:space-between;align-items:center;}
  .loading{display:flex;align-items:center;gap:10px;color:var(--ink-soft);font-size:14px;padding:20px 0;}
  .spinner{width:16px;height:16px;border:2.5px solid var(--paper-line);border-top-color:var(--ink);border-radius:50%;animation:spin .7s linear infinite;}
  @keyframes spin{to{transform:rotate(360deg);}}

  /* Teacher */
  table{width:100%;border-collapse:collapse;background:var(--card);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);}
  th,td{padding:11px 14px;text-align:left;font-size:13px;border-bottom:1px solid var(--paper-line);}
  th{font-family:'JetBrains Mono',monospace;font-size:10.5px;text-transform:uppercase;letter-spacing:.04em;color:var(--ink-soft);background:var(--paper);}
  td.name{font-weight:600;}
  .mini-bar{width:70px;height:6px;background:var(--paper);border-radius:3px;overflow:hidden;display:inline-block;vertical-align:middle;margin-right:6px;}
  .mini-bar>div{height:100%;}
  .empty{text-align:center;padding:50px 20px;color:var(--ink-soft);}
  footer.hint{margin-top:26px;text-align:center;font-size:11.5px;color:var(--ink-soft);}

  /* Teacher tabs & bank */
  .tabs{display:flex;gap:6px;margin-bottom:20px;}
  .tabs button{
    padding:8px 16px;border-radius:7px;border:1.5px solid transparent;background:transparent;
    font-family:'Inter',sans-serif;font-weight:600;font-size:13.5px;color:var(--ink-soft);cursor:pointer;
  }
  .tabs button.on{background:var(--card);border-color:var(--paper-line);color:var(--ink);box-shadow:var(--shadow);}
  .bank-layout{display:grid;grid-template-columns:260px 1fr;gap:18px;align-items:start;}
  .bank-nav{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:8px;}
  .bank-nav .tema-name{font-weight:600;font-size:13px;padding:10px 10px 4px;color:var(--ink-soft);}
  .bank-nav .sub-btn{
    width:100%;text-align:left;padding:8px 10px;border:none;background:transparent;border-radius:6px;
    font-family:'Inter',sans-serif;font-size:12.5px;cursor:pointer;color:var(--ink);display:flex;justify-content:space-between;align-items:center;
  }
  .bank-nav .sub-btn:hover{background:var(--paper);}
  .bank-nav .sub-btn.on{background:var(--paper);font-weight:600;}
  .bank-nav .sub-btn .n{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--ink-soft);background:var(--paper-line);padding:1px 5px;border-radius:8px;}
  .bank-panel{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:20px 22px;}
  .ex-item{border:1.5px solid var(--paper-line);border-radius:8px;padding:14px 16px;margin-bottom:10px;}
  .ex-item .ex-top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;margin-bottom:6px;}
  .badge{font-family:'JetBrains Mono',monospace;font-size:10px;padding:2px 7px;border-radius:5px;font-weight:700;}
  .badge.ia{background:#E4EAF5;color:#3A5089;}
  .badge.prof{background:var(--aa-soft);color:var(--aa);}
  .ex-text{font-size:13.5px;line-height:1.5;white-space:pre-wrap;}
  .ex-meta{font-size:11px;color:var(--ink-soft);margin-top:6px;}
  .ex-actions{display:flex;gap:8px;margin-top:8px;}
  .ex-actions button{background:none;border:none;font-size:11.5px;color:var(--ink-soft);cursor:pointer;text-decoration:underline;padding:0;}
  .ex-actions button:hover{color:var(--ink);}
  select, .field textarea, .field input{
    width:100%;padding:9px 11px;border:1.5px solid var(--paper-line);border-radius:7px;
    font-family:'Inter',sans-serif;font-size:14px;background:#fdfdfd;
  }
  select:focus,.field textarea:focus,.field input:focus{outline:none;border-color:var(--ink);}
  .field{margin-bottom:14px;}
  .field label{margin:0 0 6px;}
  .form-row{display:flex;gap:12px;}
  .form-row .field{flex:1;}
  .marks-pill{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-soft);background:var(--paper);padding:3px 8px;border-radius:10px;}
  .ex-image{max-width:100%;max-height:320px;display:block;margin:14px 0;border-radius:8px;border:1px solid var(--paper-line);}
  .ex-image-thumb{max-width:180px;max-height:140px;display:block;margin:8px 0;border-radius:6px;border:1px solid var(--paper-line);}
  .img-upload-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap;}
  .img-remove-btn{font-size:11.5px;color:var(--m-low);background:none;border:none;cursor:pointer;text-decoration:underline;padding:0;}
  .preview-box{min-height:24px;padding:10px 12px;background:var(--paper);border:1px solid var(--paper-line);border-radius:8px;margin-top:4px;font-size:14px;color:var(--ink);white-space:pre-wrap;}
  .preview-box:empty::before{content:'(vacío)';color:var(--ink-soft);font-style:italic;font-size:12.5px;}
  .ms-toggle{margin-top:14px;background:none;border:1.5px dashed var(--paper-line);border-radius:8px;padding:9px 14px;font-size:13px;color:var(--ink-soft);cursor:pointer;width:100%;text-align:left;font-family:'Inter',sans-serif;font-weight:600;}
  .ms-toggle:hover{border-color:var(--ink);color:var(--ink);}
  .mark-scheme{margin-top:10px;background:var(--paper);border-radius:8px;padding:14px 16px;font-family:'JetBrains Mono',monospace;font-size:12.5px;line-height:1.7;white-space:pre-wrap;color:var(--ink);}
</style>
</head>
<body>
<div class="wrap" id="app"></div>

<script>
/* ============== ESTRUCTURA: Prueba > Sección > Año ============== */
const PRUEBAS = [ {id:'P1', nombre:'Prueba 1'}, {id:'P2', nombre:'Prueba 2'} ];
const SECCIONES = [ {id:'A', nombre:'Sección A'}, {id:'B', nombre:'Sección B'} ];
const ANIOS = [2020,2021,2022,2023,2024,2025];
const ANIO_LABELS = { 2020: 'Noviembre', 2021: 'Noviembre', 2022: 'Noviembre', 2023: 'Noviembre', 2024: 'Noviembre', 2025: 'Noviembre' }; // sesión del examen para ese año, cuando se conoce
function anioConSesion(anio){ return ANIO_LABELS[anio] ? `${anio} (${ANIO_LABELS[anio]})` : `${anio}`; }
const CURSO_NOMBRE = 'Análisis y Enfoques';

function examId(prueba,seccion,anio){ return `${prueba}-${seccion}-${anio}`; }
function slugify(s){
  return s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'');
}
function masteryColor(m){
  if(m<=0) return 'var(--m-none)';
  if(m<40) return 'var(--m-low)';
  if(m<75) return 'var(--m-mid)';
  return 'var(--m-high)';
}
function masteryLabel(m){
  if(m<=0) return 'Sin empezar';
  if(m<40) return 'Iniciado';
  if(m<75) return 'En progreso';
  return 'Dominado';
}
function renderMath(container){
  try{
    if(window.renderMathInElement){
      window.renderMathInElement(container, {
        delimiters: [
          {left:'$$', right:'$$', display:true},
          {left:'$', right:'$', display:false}
        ],
        throwOnError:false
      });
    }
  }catch(e){ /* si KaTeX no cargó (sin internet), se muestra el texto tal cual */ }
}
function escapeHtml(str){
  if(str===null || str===undefined) return '';
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

/* ============== ESTADO ============== */
let STATE = { user:null, view:'login', teacher:false, openPrueba:null, openSeccion:null, session:null, teacherTab:'alumnos', bankPrueba:null, bankSeccion:null, bankAnio:null };

/* ============== ALMACENAMIENTO ============== */
async function getProgress(slug){
  try{ const r = await window.storage.get(`progress:${slug}`, true); return r ? JSON.parse(r.value) : { buckets:{} }; }
  catch(e){ return { buckets:{} }; }
}
async function saveProgress(slug, data){
  try{ await window.storage.set(`progress:${slug}`, JSON.stringify(data), true); }catch(e){ console.error(e); }
}
async function getRoster(){
  try{ const r = await window.storage.get('roster', true); return r ? JSON.parse(r.value) : []; }catch(e){ return []; }
}
async function upsertRoster(entry){
  const roster = await getRoster();
  const i = roster.findIndex(x=>x.slug===entry.slug);
  if(i>=0) roster[i] = entry; else roster.push(entry);
  try{ await window.storage.set('roster', JSON.stringify(roster), true); }catch(e){ console.error(e); }
}
async function getBank(bucketId){
  try{ const r = await window.storage.get(`bank:${bucketId}`, true); return r ? JSON.parse(r.value) : []; }catch(e){ return []; }
}
async function saveBank(bucketId, arr){
  try{ await window.storage.set(`bank:${bucketId}`, JSON.stringify(arr), true); }catch(e){ console.error(e); }
}
function newExerciseId(){ return 'ex-'+Date.now()+'-'+Math.random().toString(36).slice(2,7); }
async function addExerciseToBank(bucketId, exercise){
  const bank = await getBank(bucketId); bank.push(exercise); await saveBank(bucketId, bank); return exercise;
}
async function updateExerciseInBank(bucketId, exId, patch){
  const bank = await getBank(bucketId);
  const i = bank.findIndex(e=>e.id===exId);
  if(i>=0){ bank[i] = { ...bank[i], ...patch }; await saveBank(bucketId, bank); }
}
async function deleteExerciseFromBank(bucketId, exId){
  const bank = await getBank(bucketId);
  await saveBank(bucketId, bank.filter(e=>e.id!==exId));
}

/* ============== LLAMADAS A LA API DE CLAUDE ============== */
async function askClaude(system, user){
  const res = await fetch('https://api.anthropic.com/v1/messages', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ model:'claude-sonnet-4-6', max_tokens:1200, system, messages:[{role:'user', content:user}] })
  });
  const data = await res.json();
  const text = (data.content||[]).filter(b=>b.type==='text').map(b=>b.text).join('\n');
  return text.replace(/```json|```/g,'').trim();
}

async function generarEjercicio(ctx){
  const sys = `Eres un generador de ejercicios de práctica para el Programa del Diploma del IB, curso de Matemáticas: ${CURSO_NOMBRE} (NM), con el estilo exacto de las pruebas oficiales del IB. Responde SIEMPRE en español y SOLO con un objeto JSON válido, sin texto adicional ni backticks.`;
  const estiloSeccion = ctx.seccionId === 'A'
    ? 'Sección A: un ejercicio corto y autocontenido de un solo tema, entre 4 y 8 marks en total.'
    : 'Sección B: un ejercicio largo de varios apartados encadenados (a, b, c...), entre 12 y 17 marks en total, que puede combinar más de un tema del programa.';
  const user = `Genera un ejercicio de práctica al estilo de examen del IB, ${ctx.pruebaNombre}, ${ctx.seccionNombre} (estilo año ${ctx.anio}). ${estiloSeccion} Nivel de dificultad: ${ctx.dificultad} de 5. El ejercicio debe ceñirse al alcance del programa de NM de ${CURSO_NOMBRE}.

Formato IB obligatorio:
- Si el ejercicio tiene varios apartados, numéralos (a), (b), etc., y añade al final de cada apartado la marca entre corchetes, ej. "[2 marks]".
- El solucionario debe ser un mark scheme real: pasos numerados con la notación oficial del IB (M1 = punto de método, A1 = punto de exactitud/respuesta, R1 = punto de razonamiento, AG = respuesta dada), mostrando qué marca se otorga en cada paso.

Formato de respuesta EXACTO (JSON):
{"enunciado":"texto del ejercicio con apartados y marcas [X marks]; escribe cada expresión o ecuación matemática en notación LaTeX entre símbolos de dólar, ej. $x^2$, $\\sqrt{x}$, $\\int_0^1 f(x)\\,dx$ (esto se renderiza igual que una ecuación de Word)","tipo":"corta" o "opcion_multiple","opciones":["..."] (array de 4 opciones si tipo es opcion_multiple, si no array vacío),"respuesta_correcta":"la(s) respuesta(s) final(es), breve, también en LaTeX entre $ si aplica","solucionario":"mark scheme completo paso a paso con notación M1/A1/R1 y las expresiones matemáticas en LaTeX entre $ , líneas separadas por \\n","marcas":número total de marks del ejercicio}`;
  const raw = await askClaude(sys, user);
  return JSON.parse(raw);
}

async function corregirRespuesta(ctx, ejercicio, respuestaAlumno){
  const sys = `Eres un profesor de Matemáticas del IB, cercano y preciso, corrigiendo la respuesta de un alumno de ${CURSO_NOMBRE} (NM). Responde SIEMPRE en español y SOLO con un objeto JSON válido, sin backticks.`;
  const user = `Ejercicio: ${ejercicio.enunciado}
Respuesta correcta esperada: ${ejercicio.respuesta_correcta}
Respuesta del alumno: ${respuestaAlumno}

Evalúa si la respuesta del alumno es correcta (acepta formas equivalentes, no solo coincidencia literal). Da una retroalimentación breve (2-3 frases), constructiva y específica sobre el error si lo hay.
Formato EXACTO:
{"correcto":true o false,"feedback":"retroalimentación breve"}`;
  const raw = await askClaude(sys, user);
  return JSON.parse(raw);
}

async function pickOrGenerateEjercicio(ctx, bucketId, vistos){
  let bank = await getBank(bucketId);
  const vistosEfectivos = vistos.length >= bank.length ? [] : vistos;
  let candidatos = bank.filter(e => !vistosEfectivos.includes(e.id) && Math.abs((e.dificultad||3) - ctx.dificultad) <= 1);
  if(candidatos.length === 0) candidatos = bank.filter(e => !vistosEfectivos.includes(e.id));
  if(candidatos.length > 0) return candidatos[Math.floor(Math.random()*candidatos.length)];
  const generado = await generarEjercicio(ctx);
  const exercise = {
    id: newExerciseId(), enunciado: generado.enunciado, tipo: generado.tipo,
    opciones: generado.opciones || [], respuesta_correcta: generado.respuesta_correcta,
    solucionario: generado.solucionario || '', marcas: generado.marcas || null,
    dificultad: ctx.dificultad, origen: 'ia', creado: new Date().toISOString()
  };
  await addExerciseToBank(bucketId, exercise);
  return exercise;
}

